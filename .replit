# v1.9: lets Replit (or any cloud host) run the HUD with one click.
# Import this repo into Replit and it starts by itself — no downloads.
run = "python3 crumbs_hud.py --public"
modules = ["python-3.12", "web", "bash"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 python3 crumbs_hud.py --public"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "cloudrun"
run = "python3 crumbs_hud.py --public"
