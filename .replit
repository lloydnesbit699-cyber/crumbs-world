# v1.9: lets Replit (or any cloud host) run the HUD with one click.
# Import this repo into Replit and it starts by itself — no downloads.
# v5.22.9: use the workspace repl's webview URL, NOT a Deployment —
# deployments get an ephemeral disk, so map saves would vanish on
# restart. The workspace filesystem persists.
run = "PORT=5000 python3 crumbs_hud.py --public"
modules = ["python-3.12", "web", "bash"]

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib", "got"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Pull"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 python3 crumbs_hud.py --public"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Pull"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "git pull --rebase origin main"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "update"
mode = "sequential"
author = 65697835

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "./ops.sh update"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8778
externalPort = 3000
exposeLocalhost = true

[deployment]
deploymentTarget = "cloudrun"
run = "PORT=5000 python3 crumbs_hud.py --public"

[objectStorage]
defaultBucketID = "replit-objstore-3954851f-4cf0-4549-a1fd-6b0156020c98"
