# v1.9: lets Replit (or any cloud host) run the HUD with one click.
# Import this repo into Replit and it starts by itself — no downloads.
run = "python3 crumbs_hud.py --public"
modules = ["python-3.12", "web", "bash"]

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 python3 crumbs_hud.py --public"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Pull"
mode = "parallel"
author = 65697835

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "git pull — rebase origin main"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8778
externalPort = 3000

[deployment]
deploymentTarget = "cloudrun"
run = "PORT=5000 python3 crumbs_hud.py --public"
